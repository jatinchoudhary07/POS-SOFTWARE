        "bills_discount_range": {
          "name": "bills_discount_range",
          "value": "\"bills\".\"discount_paise\" >= 0 AND \"bills\".\"discount_paise\" <= \"bills\".\"subtotal_paise\""
        },
        "bills_taxable_matches": {
          "name": "bills_taxable_matches",
          "value": "\"bills\".\"taxable_paise\" = \"bills\".\"subtotal_paise\" - \"bills\".\"discount_paise\""
        },
