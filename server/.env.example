# Copy this file to server/.env and adjust as needed.

# Port the API (and, in production, the built frontend) is served on.
PORT=3001

# 0.0.0.0 = listen on all network interfaces so the kitchen computer on the
# same Wi-Fi can reach this machine. Use 127.0.0.1 to allow only this computer.
HOST=0.0.0.0

# SQLite database file (relative to the server/ folder). Back this file up!
DATABASE_PATH=./data/pos.db

# Comma-separated browser origins allowed to call the API directly (CORS).
# In normal use the frontend is served from the same origin, so this can stay empty.
# Example: http://192.168.1.20:5173
CORS_ORIGINS=

# Sign-in sessions. A login is signed out after this many hours without any action
# (taking orders, changing a status, loading a screen…), and always after SESSION_MAX_DAYS.
# Just leaving a screen open does not keep it signed in.
SESSION_IDLE_HOURS=12
SESSION_MAX_DAYS=7

# Session cookie "Secure" flag: auto = only when the app is opened over https://.
# Leave on auto for normal local-network (http) use.
COOKIE_SECURE=auto

# Trust reverse proxy headers (X-Forwarded-*). Set to "1", "true", or proxy IP if deployed
# behind a cloud load balancer or reverse proxy (e.g. Render, Railway, Fly.io, Nginx, Cloudflare).
# Leave empty for direct network access.
TRUST_PROXY=

# First Superadmin (optional, for a non-interactive `npm run auth:setup`).
# Remove these lines again after setup — do not leave a password in this file.
# SUPERADMIN_USERNAME=owner
# SUPERADMIN_PASSWORD=

# Automatic backups (safe SQLite online backups, checked after writing).
# Default folder: C:\Users\<you>\RestaurantPOS\backups  (outside the app folder)
# BACKUP_DIR=
BACKUP_INTERVAL_HOURS=1
# Keep every backup from the last BACKUP_KEEP_RECENT_HOURS, then one per day for
# BACKUP_KEEP_DAYS days. The newest BACKUP_MIN_KEEP backups are never deleted.
BACKUP_KEEP_RECENT_HOURS=48
BACKUP_KEEP_DAYS=60
BACKUP_MIN_KEEP=10

# Optional HTTPS on the local network. Create the files with:
#   npm run tls:setup -- <reception PC IP>
# then fill in the two paths it prints. Leave empty for plain HTTP.
TLS_CERT_FILE=
TLS_KEY_FILE=

# Restaurant name shown on receipts until you save the receipt settings.
RESTAURANT_NAME=Two Hearts Cafe
