# Copy this file to server/.env and adjust as needed.

# Port the API (and, in production, the built frontend) is served on.
PORT=3001

# 0.0.0.0 = listen on all network interfaces so the kitchen computer on the
# same Wi-Fi can reach this machine. Use 127.0.0.1 to allow only this computer.
HOST=0.0.0.0

# SQLite database file (relative to the server/ folder). Back this file up!
DATABASE_PATH=./data/pos.db

# Comma-separated browser origins allowed to call the API directly (CORS).
# In normal use the frontend is served from the same origin, so this can stay empty.
# Example: http://192.168.1.20:5173
CORS_ORIGINS=

# Sign-in sessions. 0 (the default) = never signed out automatically: a login stays signed in until the
# person signs out themselves (or the owner changes / turns off / deletes that login).
# To sign people out automatically instead: SESSION_IDLE_HOURS = hours without any action,
# SESSION_MAX_DAYS = days after which everyone must sign in again.
SESSION_IDLE_HOURS=0
SESSION_MAX_DAYS=0

# Session cookie "Secure" flag: auto = only when the app is opened over https://.
# Leave on auto for normal local-network (http) use.
COOKIE_SECURE=auto

# Trust reverse proxy headers (X-Forwarded-*). Set to "1", "true", or proxy IP if deployed
# behind a cloud load balancer or reverse proxy (e.g. Render, Railway, Fly.io, Nginx, Cloudflare).
# Leave empty for direct network access.
TRUST_PROXY=

# First Superadmin (optional, for a non-interactive `npm run auth:setup`).
# Remove these lines again after setup — do not leave a password in this file.
# SUPERADMIN_USERNAME=owner
# SUPERADMIN_PASSWORD=

# Automatic backups (safe SQLite online backups, checked after writing).
# Default folder: C:\Users\<you>\RestaurantPOS\backups  (outside the app folder)
# BACKUP_DIR=
BACKUP_INTERVAL_HOURS=1
# Keep every backup from the last BACKUP_KEEP_RECENT_HOURS, then one per day for
# BACKUP_KEEP_DAYS days. The newest BACKUP_MIN_KEEP backups are never deleted.
BACKUP_KEEP_RECENT_HOURS=48
BACKUP_KEEP_DAYS=60
BACKUP_MIN_KEEP=10

# Optional HTTPS on the local network. Create the files with:
#   npm run tls:setup -- <reception PC IP>
# then fill in the two paths it prints. Leave empty for plain HTTP.
TLS_CERT_FILE=
TLS_KEY_FILE=

# Restaurant name shown on receipts until you save the receipt settings.
RESTAURANT_NAME=Two Hearts Cafe

# Alerts for phones that are locked or have the app in the background (Web Push).
# Make a pair once with:  npx web-push generate-vapid-keys   (keep the private key secret; never commit it)
# Leave empty to switch these alerts off. VAPID_SUBJECT is a https:// address of this server (or mailto:).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# --- Card/UPI terminal (Paytm) -------------------------------------------------------------------
# OFF by default. Stage 1 contains only a PRACTICE terminal that moves no money and never contacts Paytm.
# PAYTM_ENABLED=true with PAYTM_MODE=mock turns the practice terminal on (refused when NODE_ENV=production).
# PAYTM_MODE=live is not available yet. The real Paytm credentials (merchant id, terminal id, channel id, key) are not
# used by this version and must never be put in a file that is committed.
PAYTM_ENABLED=false
PAYTM_MODE=mock
# What the practice terminal does: SUCCESS, CUSTOMER_CANCEL, BANK_REJECT, TERMINAL_OFFLINE, SALE_TIMEOUT, ACCEPTED_NO_RESULT,
# DUPLICATE_ID, TERMINAL_BUSY, INVALID_CHECKSUM, MISMATCH_AMOUNT, MISMATCH_MID, MISMATCH_TID
PAYTM_MOCK_SCENARIO=SUCCESS
# Status checks: every PAYTM_POLL_FAST_MS at first, then every PAYTM_POLL_SLOW_MS; unfinished after PAYTM_MAX_WAIT_MINUTES = unknown.
PAYTM_POLL_FAST_MS=3000
PAYTM_POLL_SLOW_MS=10000
PAYTM_MAX_WAIT_MINUTES=10
PAYTM_SALE_TIMEOUT_MS=15000
