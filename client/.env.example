# Copy to client/.env (optional).

# Shown in the header of the POS screen.
VITE_RESTAURANT_NAME=Two Hearts Cafe

# Leave empty (recommended): the app talks to the computer that served the page, so the
# kitchen computer automatically reaches the reception computer. Only set this if the
# frontend is hosted on a different address than the API, e.g. http://192.168.1.20:3001
# (and then add the frontend's origin to CORS_ORIGINS in server/.env).
VITE_API_URL=

# Development only: where the Vite dev server forwards /api and /socket.io requests.
API_PROXY_TARGET=http://localhost:3001
